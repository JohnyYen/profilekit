{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Education",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["institution", "area", "degree", "start_date", "end_date", "location", "highlights"],
    "properties": {
      "institution": { "type": "string" },
      "area": { "type": "string" },
      "degree": { "type": "string" },
      "start_date": { "type": "string" },
      "end_date": { "type": "string" },
      "location": { "type": "string" },
      "summary": { "type": "string" },
      "highlights": { "type": "array", "items": { "type": "string" } }
    }
  }
}
